{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "refrigerantes-mollier",
  "version": "1.0.0",
  "identifier": "com.refrigeracion.mollier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diagramas Termodinámicos de Refrigerantes log(p)–h",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
